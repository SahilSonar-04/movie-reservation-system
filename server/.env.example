# For MongoDB Atlas, use:
MONGO_URI= your connection

# development or production -> no rate limiters for dev
NODE_ENV=development

#nodemailer
EMAIL_USER=your mail
EMAIL_PASS=google security pass of that mail

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173 #Or frontend url deployed


# Logging
LOG_LEVEL=info

# NEW STRIPE VARIABLES
STRIPE_SECRET_KEY=sk_test_your key
STRIPE_WEBHOOK_SECRET=whsec_.....your key

# TMDB Access Token & Auto-Sync Configuration
TMDB_ACCESS_TOKEN= generate api key from tmdb website
# Auto-sync interval in hours (default: 12)
TMDB_SYNC_INTERVAL_HOURS=12